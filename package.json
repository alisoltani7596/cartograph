{
  "name": "cartograph",
  "version": "1.0.0",
  "private": true,
  "description": "Turn grocery receipts into a private spending dashboard. Works best with Costco receipts. Everything stays in your browser.",
  "type": "module",
  "license": "MIT",
  "author": "Ali Soltaninezhad",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "synthetic:generate": "tsx eval/synthetic/generate.ts",
    "eval": "tsx eval/run.ts",
    "eval:synthetic": "tsx eval/run.ts --dataset eval/synthetic --method ocr --split all --check"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^26.6.6",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
